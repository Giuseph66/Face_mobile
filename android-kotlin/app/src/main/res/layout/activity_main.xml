<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/title"
        android:textColor="#F0F6F2"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp"
        android:accessibilityLiveRegion="polite"
        android:text="@string/camera_starting"
        android:textColor="#AAC0B2"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginBottom="8dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/mapping_mode" android:textColor="#AAC0B2" android:textSize="13sp" />
        <Spinner android:id="@+id/mapping_mode" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1.3" android:backgroundTint="#7EF3B4" android:spinnerMode="dropdown"
            android:contentDescription="@string/mapping_mode" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/face_controls"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/face_limit_label"
            android:textColor="#AAC0B2"
            android:textSize="13sp" />
        <Spinner
            android:id="@+id/face_limit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:backgroundTint="#7EF3B4"
            android:contentDescription="@string/face_limit_label"
            android:spinnerMode="dropdown" />
    </LinearLayout>

    <TextView
        android:id="@+id/face_limit_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/many_faces_hint"
        android:textColor="#AAC0B2"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/enrollment_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="112dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <br.com.sonolencia.faceencoder.EnrollmentGuideView android:id="@+id/enrollment_demo"
                android:layout_width="96dp" android:layout_height="96dp" android:importantForAccessibility="yes" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:layout_marginStart="8dp">
                <TextView android:id="@+id/enrollment_step" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/enrollment_step" android:textSize="12sp" android:textColor="#AAC0B2" />
                <TextView android:id="@+id/enrollment_instruction" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/enrollment_front" android:textSize="16sp" android:fontFamily="sans-serif-medium"
                    android:textColor="#F0F6F2" android:accessibilityLiveRegion="polite" />
                <ProgressBar android:id="@+id/enrollment_progress" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="12dp" android:max="15"
                    android:progressTint="#7EF3B4" android:contentDescription="@string/enrollment_progress" />
            </LinearLayout>
        </LinearLayout>
        <EditText
            android:id="@+id/person_name"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/person_name"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="40"
            android:singleLine="true"
            android:textColor="#F0F6F2"
            android:textColorHint="#AAC0B2"
            android:autofillHints="name" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
            <Button android:id="@+id/enrollment_start" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:text="@string/enrollment_start" android:textAllCaps="false" />
            <Button android:id="@+id/enrollment_cancel" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:text="@string/cancel" android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/recognition_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="8dp" android:text="@string/recognition_starting" android:textColor="#AAC0B2"
        android:textSize="12sp" android:accessibilityLiveRegion="polite" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#050807">
        <androidx.camera.view.PreviewView
            android:id="@+id/camera_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <br.com.sonolencia.faceencoder.FaceOverlayView
            android:id="@+id/face_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/pause"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#253A2E"
            android:text="@string/pause"
            android:textAllCaps="false"
            android:textColor="#E2F2E8"
            android:textSize="13sp" />
        <Button
            android:id="@+id/indices"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:backgroundTint="#253A2E"
            android:text="@string/numbers"
            android:textAllCaps="false"
            android:textColor="#E2F2E8"
            android:textSize="13sp" />
        <Button
            android:id="@+id/save"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#7EF3B4"
            android:text="@string/save"
            android:textAllCaps="false"
            android:textColor="#101714"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/face_actions" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
        <Button android:id="@+id/enroll" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:text="@string/enroll" android:textAllCaps="false"
            android:backgroundTint="#253A2E" android:textColor="#E2F2E8" />
        <Button android:id="@+id/people" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:text="@string/people" android:textAllCaps="false"
            android:backgroundTint="#253A2E" android:textColor="#E2F2E8" />
    </LinearLayout>

    <TextView
        android:id="@+id/capture_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/touch_hint"
        android:textColor="#AAC0B2"
        android:textSize="11sp" />
</LinearLayout>
